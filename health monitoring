// =====================================================================
//  DSP
// =====================================================================
struct HighPass {                       // 1st order, baseline wander
  float a = 0, xPrev = 0, yPrev = 0;
  void  design(float fc, float fs) { const float rc = 1.0f / (2.0f * PI * fc); a = rc / (rc + 1.0f / fs); }
  float process(float x) { const float y = a * (yPrev + x - xPrev); xPrev = x; yPrev = y; return y; }
  void  reset(float x) { xPrev = x; yPrev = 0; }
};

struct Biquad {                         // RBJ biquad, transposed direct form II
  float b0 = 1, b1 = 0, b2 = 0, a1 = 0, a2 = 0, z1 = 0, z2 = 0;
  void set(float n0, float n1, float n2, float d0, float d1, float d2) {
    b0 = n0 / d0; b1 = n1 / d0; b2 = n2 / d0; a1 = d1 / d0; a2 = d2 / d0;
  }
  void notch(float f0, float fs, float q) {
    const float w = 2.0f * PI * f0 / fs, c = cosf(w), al = sinf(w) / (2.0f * q);
    set(1.0f, -2.0f * c, 1.0f, 1.0f + al, -2.0f * c, 1.0f - al);
  }
  void lowpass(float f0, float fs, float q) {
    const float w = 2.0f * PI * f0 / fs, c = cosf(w), al = sinf(w) / (2.0f * q);
    set((1.0f - c) * 0.5f, 1.0f - c, (1.0f - c) * 0.5f, 1.0f + al, -2.0f * c, 1.0f - al);
  }
  void highpass(float f0, float fs, float q) {
    const float w = 2.0f * PI * f0 / fs, c = cosf(w), al = sinf(w) / (2.0f * q);
    set((1.0f + c) * 0.5f, -(1.0f + c), (1.0f + c) * 0.5f, 1.0f + al, -2.0f * c, 1.0f - al);
  }
  float process(float x) {
    const float y = b0 * x + z1;
    z1 = b1 * x - a1 * y + z2;
    z2 = b2 * x - a2 * y;
    return y;
  }
  void reset() { z1 = z2 = 0; }
};

// Pan-Tompkins style QRS detector: 5-15 Hz band-pass -> derivative ->
// squaring -> 150 ms moving-window integration -> adaptive threshold, with
// a 200 ms refractory period, T-wave rejection and an absolute amplitude
// floor so that noise on a flat line is never counted as a heartbeat.
struct QrsDetector {
  Biquad   hp, lp;
  float    bHist[5];
  float    mwiBuf[QRS_MWI_LEN], bWin[QRS_MWI_LEN], dWin[QRS_MWI_LEN];
  uint8_t  idx;
  uint16_t resum;
  float    mwiSum, m1, m2, spki, npki, thr, lastQrsSlope;
  bool     learning, haveQrs;
  uint32_t learnStart, learnN, lastQrsMs;
  float    learnMax, learnSum;
  uint16_t rr[QRS_RR_N];
  uint8_t  rrN, rrIdx;
  bool     candValid;                 // best sub-threshold peak since last QRS
  float    candPk, candSlope;         // (search-back for a missed beat)
  uint32_t candMs;

  void design() {
    hp.highpass(5.0f, ECG_FS, 0.7071f);
    lp.lowpass(15.0f, ECG_FS, 0.7071f);
  }
  // (Re)learn thresholds from the next 2 s of signal. Filter state is kept.
  void startLearning(uint32_t now) {
    learning = true; learnStart = now; learnN = 0;
    learnMax = learnSum = 0;
    haveQrs = false; candValid = false;
    rrN = rrIdx = 0;
    lastQrsMs = now;
  }
  void reset(uint32_t now) {
    hp.reset(); lp.reset();
    memset(bHist, 0, sizeof bHist);
    memset(mwiBuf, 0, sizeof mwiBuf); memset(bWin, 0, sizeof bWin); memset(dWin, 0, sizeof dWin);
    idx = 0; resum = 0;
    mwiSum = m1 = m2 = spki = npki = thr = lastQrsSlope = 0;
    candPk = candSlope = 0; candMs = now;
    startLearning(now);
  }
  float windowPP() const {
    float mn = bWin[0], mx = bWin[0];
    for (int i = 1; i < QRS_MWI_LEN; i++) { if (bWin[i] < mn) mn = bWin[i]; if (bWin[i] > mx) mx = bWin[i]; }
    return mx - mn;
  }
  float windowMaxSlope() const {
    float mx = 0;
    for (int i = 0; i < QRS_MWI_LEN; i++) if (dWin[i] > mx) mx = dWin[i];
    return mx;
  }
  float medianRR(uint8_t* consistentPct = nullptr) const {
    if (rrN == 0) return 0;
    uint16_t t[QRS_RR_N];
    for (uint8_t i = 0; i < rrN; i++) t[i] = rr[i];
    for (uint8_t i = 1; i < rrN; i++) {          // insertion sort, n <= 8
      const uint16_t v = t[i]; int j = i - 1;
      while (j >= 0 && t[j] > v) { t[j + 1] = t[j]; j--; }
      t[j + 1] = v;
    }
    const float med = (rrN & 1) ? t[rrN / 2] : 0.5f * (t[rrN / 2 - 1] + t[rrN / 2]);
    if (consistentPct) {
      uint8_t ok = 0;
      for (uint8_t i = 0; i < rrN; i++) if (fabsf(t[i] - med) <= QRS_RR_TOLERANCE * med) ok++;
      *consistentPct = (uint8_t)(ok * 100 / rrN);
    }
    return med;
  }
  void accept(float pk, float slope, uint32_t t, bool searchBack) {
    const uint32_t since = t - lastQrsMs;
    spki = searchBack ? 0.25f * pk + 0.75f * spki : 0.125f * pk + 0.875f * spki;
    if (haveQrs && since >= QRS_RR_MIN_MS && since <= QRS_RR_MAX_MS) {
      rr[rrIdx] = (uint16_t)since;
      rrIdx = (uint8_t)((rrIdx + 1) % QRS_RR_N);
      if (rrN < QRS_RR_N) rrN++;
    }
    haveQrs = true;
    lastQrsMs = t;
    lastQrsSlope = slope;
    candValid = false;
  }
  // Returns true when a QRS complex is detected.
  bool process(float x, uint32_t now) {
    const float b = lp.process(hp.process(x));
    bHist[4] = bHist[3]; bHist[3] = bHist[2]; bHist[2] = bHist[1]; bHist[1] = bHist[0]; bHist[0] = b;
    const float d  = (2.0f * bHist[0] + bHist[1] - bHist[3] - 2.0f * bHist[4]) * 0.125f;
    const float sq = d * d;
    mwiSum += sq - mwiBuf[idx];
    mwiBuf[idx] = sq; bWin[idx] = b; dWin[idx] = fabsf(d);
    idx = (uint8_t)((idx + 1) % QRS_MWI_LEN);
    if (++resum >= 1000) {                       // cancel float drift
      resum = 0; mwiSum = 0;
      for (int i = 0; i < QRS_MWI_LEN; i++) mwiSum += mwiBuf[i];
    }
    float m = mwiSum / QRS_MWI_LEN;
    if (m < 0) m = 0;

    bool qrs = false;
    if (learning) {
      if (m > learnMax) learnMax = m;
      learnSum += m; learnN++;
      if (now - learnStart >= QRS_LEARN_MS) {
        spki = learnMax / 3.0f;
        npki = (learnN ? learnSum / learnN : 0) * 0.5f;
        thr  = npki + 0.25f * (spki - npki);
        learning = false;
        lastQrsMs = now;
      }
    } else {
      if (m1 > m2 && m1 >= m) {                  // local MWI peak at previous sample
        const float    pk       = m1;
        const uint32_t since    = now - lastQrsMs;
        const float    slope    = windowMaxSlope();
        const bool     eligible = since > QRS_REFRACTORY_MS && windowPP() >= QRS_MIN_PP_UV;
        const bool     tWave    = haveQrs && since < QRS_TWAVE_MS && slope < 0.5f * lastQrsSlope;
        const bool     artefact = spki > 0 && pk > QRS_ARTEFACT_X * spki;   // motion/electrode pop
        if (eligible && !tWave && !artefact && pk > thr) {
          accept(pk, slope, now, false);
          qrs = true;
        } else {
          if (!artefact) npki = 0.125f * pk + 0.875f * npki;   // artefacts must not inflate noise level
          if (eligible && !tWave && !artefact && pk > 0.5f * thr && (!candValid || pk > candPk)) {
            candValid = true; candPk = pk; candSlope = slope; candMs = now;
          }
        }
      }
      // Search-back: no beat for 1.66 x the usual RR -> take the best
      // half-threshold candidate as the missed beat (Pan-Tompkins).
      if (!qrs && candValid && rrN >= 2) {
        const float med = medianRR();
        if (med > 0 && (now - lastQrsMs) > (uint32_t)(1.66f * med)) {
          accept(candPk, candSlope, candMs, true);
          qrs = true;
        }
      }
      // Thresholds learned during an artefact (electrode just attached,
      // patient moved) can be far too high. Nothing for 3 s -> learn again.
      if (!qrs && (now - lastQrsMs) > QRS_RELEARN_MS) startLearning(now);
      thr = npki + 0.25f * (spki - npki);
    }
    m2 = m1; m1 = m;
    return qrs;
  }
  // Heart rate from the median RR, or 0 if there are too few beats or the
  // intervals are too irregular to trust (noise, artefact, missed beats).
  float hr(uint32_t now) const {
    if (rrN < QRS_MIN_RR_FOR_HR || (now - lastQrsMs) > QRS_HR_TIMEOUT_MS) return 0;
    uint8_t pct = 0;
    const float med = medianRR(&pct);
    if (med <= 0 || pct < QRS_CONSISTENT_PCT) return 0;
    return 60000.0f / med;
  }
  // A regular rhythm was seen within the last `windowMs`.
  bool rhythmPresent(uint32_t now, uint32_t windowMs) const {
    return (now - lastQrsMs) < windowMs && hr(now) > 0;
  }
  // Stricter test used to switch leads ON against the LO pins: 8 RR
  // intervals, >= 85 % within ±15 % of the median, 30–200 bpm. Floating
  // (disconnected) inputs never produce a rhythm this regular.
  bool rhythmStrong(uint32_t now, uint32_t windowMs) const {
    if (rrN < QRS_RR_N || (now - lastQrsMs) >= windowMs) return false;
    const float med = medianRR();
    if (med < 300.0f || med > 2000.0f) return false;
    uint8_t ok = 0;
    for (uint8_t i = 0; i < rrN; i++) if (fabsf(rr[i] - med) <= 0.15f * med) ok++;
    return ok * 100 >= 85 * rrN;
  }
};

