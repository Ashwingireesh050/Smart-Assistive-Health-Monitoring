static void jsonEscape(String& out, const String& val);
static void jsonField(String& out, const char* key, const String& val, bool comma) {
  if (comma) out += ',';
  out += '"'; out += key; out += "\":";
  jsonEscape(out, val);
}

// Appends val as a quoted, escaped JSON string.
static void jsonEscape(String& out, const String& val) {
  out += '"';
  for (size_t i = 0; i < val.length(); i++) {
    const char c = val[i];
    switch (c) {
      case '"':  out += "\\\""; break;
      case '\\': out += "\\\\"; break;
      case '\n': out += "\\n";  break;
      case '\r': out += "\\r";  break;
      case '\t': out += "\\t";  break;
      default:
        if ((uint8_t)c < 0x20) { char e[8]; snprintf(e, sizeof e, "\\u%04x", (unsigned)(uint8_t)c); out += e; }
        else out += c;
    }
  }
  out += '"';
}

// Strip control characters (except newline in notes), cap length without
// cutting a UTF-8 character in half, trim spaces.
static String cleanField(const String& in, size_t maxLen, bool allowNewline) {
  String out;
  out.reserve(maxLen + 1);
  for (size_t i = 0; i < in.length() && out.length() < maxLen; i++) {
    const char c = in[i];
    if ((uint8_t)c < 0x20 && !(allowNewline && c == '\n')) continue;
    out += c;
  }
  if (in.length() > maxLen) {
    while (out.length() && (((uint8_t)out[out.length() - 1]) & 0xC0) == 0x80) out.remove(out.length() - 1);
    if (out.length() && (((uint8_t)out[out.length() - 1]) & 0xC0) == 0xC0) out.remove(out.length() - 1);
  }
  out.trim();
  return out;
}

static bool oneOf(const String& v, const char* const* opts, size_t n) {
  for (size_t i = 0; i < n; i++) if (v == opts[i]) return true;
  return false;
}

