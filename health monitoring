static void watchdogInit() {
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  esp_task_wdt_config_t cfg;
  cfg.timeout_ms     = WDT_TIMEOUT_S * 1000;
  cfg.idle_core_mask = 1;             // keep watching core-0 idle (WiFi core)
  cfg.trigger_panic  = true;          // hung task -> reboot
  if (esp_task_wdt_reconfigure(&cfg) == ESP_ERR_INVALID_STATE) esp_task_wdt_init(&cfg);
#else
  esp_task_wdt_init(WDT_TIMEOUT_S, true);   // IDF 4.x: (re)configures timeout + panic
#endif
}

static const char* resetReasonText(esp_reset_reason_t r) {
  switch (r) {
    case ESP_RST_POWERON:  return "power-on";
    case ESP_RST_EXT:      return "external pin";
    case ESP_RST_SW:       return "software restart";
    case ESP_RST_PANIC:    return "PANIC / exception";
    case ESP_RST_INT_WDT:  return "INTERRUPT WATCHDOG";
    case ESP_RST_TASK_WDT: return "TASK WATCHDOG (a task hung)";
    case ESP_RST_WDT:      return "OTHER WATCHDOG";
    case ESP_RST_DEEPSLEEP:return "deep-sleep wake";
    case ESP_RST_BROWNOUT: return "BROWN-OUT (supply dipped — check power)";
    default:               return "unknown";
  }
}

// =====================================================================
//  SENSOR TASK — core 1, 250 Hz. Owns ADC, LO pins and the I2C bus.
// =====================================================================
static void sensorTask(void* arg) {
  (void)arg;
  esp_task_wdt_add(NULL);

  s_hpf.design(ECG_HP_HZ, ECG_FS);
  s_notch.notch(MAINS_HZ, ECG_FS, ECG_NOTCH_Q);
  s_lpf.lowpass(ECG_LP_HZ, ECG_FS, 0.7071f);
  s_qrs.design();
  s_qrs.reset(millis());

  // 1 s signal-quality window
  uint16_t winMin = 4095, winMax = 0;
  uint32_t winN = 0, winPinned = 0, winSum = 0, winStart = millis();
  bool     saturated = false, clipping = false, flat = false, wasSaturated = false;

  // LO pins: debounced as a bitmask (bit0 = LO+, bit1 = LO-)
  uint8_t  loStable = LEAD_LO_PLUS | LEAD_LO_MINUS, loPending = loStable;
  uint32_t loPendingMs = millis();

  bool     leadOff = true;
  bool     overrideLogged = false;
  uint8_t  poxDiv = 0;

  // Seed the 0.5 Hz high-pass with the real DC level. Starting from 0 caused
  // a multi-second transient that made the QRS detector learn a threshold
  // ~10x too high, so beats were missed after every boot.
  {
    uint32_t a = 0;
    for (int i = 0; i < ECG_OVERSAMPLE; i++) a += analogRead(ECG_OUTPUT_PIN);
    s_hpf.reset((a / ECG_OVERSAMPLE) * UV_PER_COUNT);
  }

  TickType_t wake = xTaskGetTickCount();
  for (;;) {
    vTaskDelayUntil(&wake, SENSOR_PERIOD);
    esp_task_wdt_reset();
    const uint32_t now = millis();

    // ---------------- ECG acquisition ----------------
    uint32_t acc = 0;
    for (int i = 0; i < ECG_OVERSAMPLE; i++) acc += analogRead(ECG_OUTPUT_PIN);
    const uint16_t raw    = (uint16_t)(acc / ECG_OVERSAMPLE);
    const bool     pinned = raw <= ADC_PINNED_LOW || raw >= ADC_PINNED_HIGH;

    uint8_t loRaw = 0;
    if (digitalRead(LO_PLUS_PIN)  == HIGH) loRaw |= LEAD_LO_PLUS;
    if (digitalRead(LO_MINUS_PIN) == HIGH) loRaw |= LEAD_LO_MINUS;
    if (loRaw != loStable) {                       // debounce LO pins (300 ms)
      if (loRaw != loPending) { loPending = loRaw; loPendingMs = now; }
      if (now - loPendingMs >= LO_DEBOUNCE_MS) loStable = loRaw;
    } else {
      loPending = loRaw;
    }

    // ---------------- 1 s signal-quality window ----------------
    if (raw < winMin) winMin = raw;
    if (raw > winMax) winMax = raw;
    winN++; winSum += raw;
    if (pinned) winPinned++;
    if (now - winStart >= SIG_WINDOW_MS) {
      const uint8_t pct = (uint8_t)(winN ? winPinned * 100 / winN : 0);
      saturated = pct >= SATURATED_PCT;            // output stuck at a rail
      clipping  = pct >= CLIPPING_PCT;
      flat      = (winMax - winMin) < FLAT_RANGE_COUNTS;
      s_dbgRawMin = winMin; s_dbgRawMax = winMax;
      s_dbgRawAvg = (uint16_t)(winN ? winSum / winN : 0);
      s_dbgPinnedPct = pct;
      winMin = 4095; winMax = 0; winN = 0; winPinned = 0; winSum = 0;
      winStart = now;
    }

    const float uv = raw * UV_PER_COUNT;           // µV at the electrodes (+DC)

    // After full saturation the filters/detector hold garbage: restart them
    // the moment the amplifier output comes back into range.
    if (wasSaturated && !saturated) {
      s_hpf.reset(uv); s_notch.reset(); s_lpf.reset();
      s_qrs.reset(now);
    }
    wasSaturated = saturated;

    const float y = s_lpf.process(s_notch.process(s_hpf.process(uv)));

    // The QRS detector runs on every in-range sample, even while the LO pins
    // say "off", so a readable ECG can override a flaky LO pin.
    bool beat = false;
    if (!pinned && !saturated) beat = s_qrs.process(y, now);
    const bool rhythm = s_qrs.rhythmPresent(now, LO_OVERRIDE_MS);

    // ---------------- Lead-off decision ----------------
    // Override hysteresis: a confirmed connection is KEPT while a regular
    // rhythm continues; switching ON against the LO pins needs a strong rhythm.
    const bool loOff     = loStable != 0;
    const bool loIgnored = LO_SIGNAL_OVERRIDE && loOff && !saturated &&
                           (leadOff ? s_qrs.rhythmStrong(now, LO_OVERRIDE_MS) : rhythm);
    const bool off = saturated ||
                     (loOff && !loIgnored) ||
                     (!LO_PINS_TRUSTED && flat);

    uint8_t reason = loStable;
    if (saturated) reason |= LEAD_SATURATED;
    if (clipping)  reason |= LEAD_CLIPPING;
    if (loIgnored) reason |= LEAD_LO_IGNORED;
    s_leadReason = reason;

    if (loIgnored && !overrideLogged) {
      overrideLogged = true;
      Serial.printf("[ECG] LO pin(s) report OFF (0x%02X) but a regular ECG is present — "
                    "ignoring LO. Check electrode gel/contact and LO wiring.\n", loStable);
    }
    if (!loOff) overrideLogged = false;

    // Filters and detector run continuously, so nothing is reset here (in
    // v3 every lead flicker reset them and the heart rate dropped out).
    if (off != leadOff) {
      leadOff = off;
      if (!leadOff) {                              // leads on: start asystole timer
        s_lastQrsMs = now;
        s_leadOnSinceMs = now;
      }
      s_leadOff = leadOff;
    }

    int16_t out = 0;                               // leads off -> flat line
    if (!leadOff) {
      if (beat) { s_qrsCount = s_qrsCount + 1; s_lastQrsMs = now; }
      s_ecgHr = s_qrs.hr(now);
      out = (int16_t)constrain(lroundf(y), -32767L, 32767L);
    } else {
      s_ecgHr = 0;
    }
    if (xQueueSend(ecgQueue, &out, 0) != pdTRUE) s_ecgDrops = s_ecgDrops + 1;

#if ECG_SERIAL_PLOT
    Serial.printf("raw:%u,ecg_uV:%d,lo:%u\n", raw, (int)out, loStable);
#endif

    // ---------------- Pulse oximeter (own driver + DSP) ----------------
    if (++poxDiv >= POX_UPDATE_DIV) {
      poxDiv = 0;
      poService(now);
    }
  }
}

// =====================================================================
//  VITALS + ALARM ENGINE (loop context)
// =====================================================================
// ==== PULSE DISPLAY BEGIN ====
// Stable pulse rate + SpO2 for the dashboard (called once per second).
float    g_pulseFilt = 0, g_spo2Filt = 0;
uint32_t g_pulseHoldUntil = 0;
uint8_t  g_spo2Hist[SPO2_MEDIAN_N];
uint8_t  g_spo2HistN = 0, g_spo2HistIdx = 0;

static void spo2Reset() { g_spo2 = 0; g_spo2Filt = 0; g_spo2HistN = g_spo2HistIdx = 0; }

static void updatePulseDisplay() {
  const uint8_t  st = s_poState;
  const float    hr = s_poHr;
  const float    sp = s_poSpo2;
  const uint32_t t  = millis();
  const bool valid    = st == PO_GOOD && hr >= 30.0f && hr <= 200.0f;
  const bool holdable = st == PO_WEAK || st == PO_ADJUSTING;   // finger still on

  if (valid) {
    // Confirmed big change (module already required 3 s of agreement): snap to it.
    if (g_pulseFilt <= 0 || fabsf(hr - g_pulseFilt) > 12.0f) g_pulseFilt = hr;
    else g_pulseFilt += PULSE_EMA_ALPHA * (hr - g_pulseFilt);
    g_pulseHoldUntil = t + PULSE_HOLD_MS;
    if (g_pulse == 0 || fabsf(g_pulseFilt - g_pulse) >= PULSE_HYST_BPM) g_pulse = (int)lroundf(g_pulseFilt);
  } else if (holdable && g_pulse > 0 && (int32_t)(g_pulseHoldUntil - t) > 0) {
    // brief motion / LED re-tune: keep the last stable value
  } else {
    g_pulse = 0;
    g_pulseFilt = 0;
  }

  if (valid && g_pulse > 0 && sp >= SPO2_MIN_VALID && sp <= 100.0f) {
    g_spo2Hist[g_spo2HistIdx] = (uint8_t)lroundf(sp);
    g_spo2HistIdx = (uint8_t)((g_spo2HistIdx + 1) % SPO2_MEDIAN_N);
    if (g_spo2HistN < SPO2_MEDIAN_N) g_spo2HistN++;
    uint8_t v[SPO2_MEDIAN_N];
    for (uint8_t i = 0; i < g_spo2HistN; i++) v[i] = g_spo2Hist[i];
    for (uint8_t i = 1; i < g_spo2HistN; i++) {
      const uint8_t x = v[i]; int j = i - 1;
      while (j >= 0 && v[j] > x) { v[j + 1] = v[j]; j--; }
      v[j + 1] = x;
    }
    const float m = v[g_spo2HistN / 2];
    g_spo2Filt = (g_spo2Filt <= 0) ? m : g_spo2Filt + SPO2_EMA_ALPHA * (m - g_spo2Filt);
    if (g_spo2 == 0 || fabsf(g_spo2Filt - g_spo2) >= SPO2_HYST_PCT) g_spo2 = (int)lroundf(g_spo2Filt);
  } else if (g_pulse == 0) {
    spo2Reset();                                 // value disappears with the pulse
  }
}
// ==== PULSE DISPLAY END ====

static void computeVitals() {
  const bool  leadOff = s_leadOff;
  const float ecgHrF  = s_ecgHr;
  g_ecgHr = (!leadOff && ecgHrF > 0) ? (int)lroundf(ecgHrF) : 0;

  // g_pulse / g_spo2 are produced by updatePulseDisplay() at 1 Hz.
#if HR_FROM_PULSE_OX
  g_hr = (g_pulse > 0) ? g_pulse : (HR_FALLBACK_TO_ECG ? g_ecgHr : 0);
#else
  g_hr = (g_ecgHr > 0) ? g_ecgHr : g_pulse;
#endif

  if (!g_standby) {                                // arm technical alarms only after
    if (g_ecgHr > 0)        g_ecgArmed  = true;    // a sensor has produced valid data
    if (g_pulse > 0)        g_spo2Armed = true;
    if (g_temperature > 0)  g_tempArmed = true;
  }
}

static void alarmUpdate(uint8_t id, bool cond, uint32_t now) {
  AlarmState& a = g_al[id];
  if (cond) {
    a.clearing = false;
    if (!a.cond) { a.cond = true; a.condSince = now; }
    if (!a.active && now - a.condSince >= ALARM_DEFS[id].delayMs) {
      a.active = true;
      a.silencedUntil = 0;
      Serial.printf("[ALARM] ON   %s (priority %u)\n", ALARM_DEFS[id].name, ALARM_DEFS[id].prio);
    }
  } else {
    a.cond = false;
    if (a.active) {
      if (!a.clearing) { a.clearing = true; a.clearSince = now; }
      if (now - a.clearSince >= ALARM_CLEAR_MS) {
        a.active = false; a.clearing = false;
        Serial.printf("[ALARM] OFF  %s\n", ALARM_DEFS[id].name);
      }
    }
  }
}

static bool alarmSilenced(uint8_t id, uint32_t now) {
  return g_al[id].silencedUntil != 0 && (int32_t)(g_al[id].silencedUntil - now) > 0;
}

static void alarmAck(int id, uint32_t now) {
  if (id < 0 || id >= AL_COUNT || !g_al[id].active) return;
  g_al[id].silencedUntil = now + ALARM_SILENCE_MS;
  if (g_al[id].silencedUntil == 0) g_al[id].silencedUntil = 1;
  g_forceAlarmSend = true;
  Serial.printf("[ALARM] ACK  %s (silenced %lu s)\n", ALARM_DEFS[id].name, (unsigned long)(ALARM_SILENCE_MS / 1000));
}

static void setStandby(bool on) {
  if (g_standby == on) return;
  g_standby = on;
  memset(g_al, 0, sizeof g_al);
  g_ecgArmed = g_spo2Armed = g_tempArmed = false;
  g_forceAlarmSend = true;
  Serial.println(on ? F("[ALARM] STANDBY — all alarms paused")
                    : F("[ALARM] Monitoring resumed"));
}

// Returns the highest priority among active, un-silenced alarms (0 = none).
static uint8_t evaluateAlarms() {
  if (g_standby) return 0;
  const uint32_t lastQrs     = s_lastQrsMs;
  const uint32_t leadOnSince = s_leadOnSinceMs;
  const bool     leadOff     = s_leadOff;
  const bool     poxReady    = s_poxReady;
  const uint32_t now         = millis();           // read after the snapshot

  alarmUpdate(AL_ASYSTOLE, g_ecgArmed && !leadOff &&
              (now - leadOnSince) >= ASYSTOLE_LEADS_ON_MS &&
              (now - lastQrs) >= ASYSTOLE_NO_QRS_MS, now);
  alarmUpdate(AL_HR_LOW,     g_hr > 0 && g_hr < HR_CRIT_LOW, now);
  alarmUpdate(AL_HR_HIGH,    g_hr > HR_CRIT_HIGH, now);
  alarmUpdate(AL_SPO2_LOW,   g_spo2 > 0 && g_spo2 < SPO2_CRIT_LOW, now);
  alarmUpdate(AL_TEMP_HIGH,  g_temperature > TEMP_ALARM_HIGH, now);
  alarmUpdate(AL_TEMP_LOW,   g_temperature > 0 && g_temperature < TEMP_ALARM_LOW, now);
  alarmUpdate(AL_LEADS_OFF,  g_ecgArmed && leadOff, now);
  alarmUpdate(AL_SPO2_NOSIG, g_spo2Armed && poxReady && g_pulse == 0, now);
  alarmUpdate(AL_SPO2_LOST,  g_spo2Armed && !poxReady, now);
  alarmUpdate(AL_TEMP_LOST,  g_tempArmed && g_temperature == 0, now);

  uint8_t top = 0;
  for (uint8_t i = 0; i < AL_COUNT; i++) {
    if (g_al[i].active && !alarmSilenced(i, now) && ALARM_DEFS[i].prio > top) top = ALARM_DEFS[i].prio;
  }
  return top;
}

// "A:<standby>|id,prio,silenced;id,prio,silenced..."
static void buildAlarmMsg(uint32_t now) {
  g_aMsg = "A:";
  g_aMsg += g_standby ? '1' : '0';
  g_aMsg += '|';
  bool first = true;
  for (uint8_t i = 0; i < AL_COUNT; i++) {
    if (!g_al[i].active) continue;
    if (!first) g_aMsg += ';';
    first = false;
    g_aMsg += (int)i;                     g_aMsg += ',';
    g_aMsg += (int)ALARM_DEFS[i].prio;    g_aMsg += ',';
    g_aMsg += alarmSilenced(i, now) ? '1' : '0';
  }
}

static void updateAlarmLed(uint8_t topPrio, uint32_t now) {
  if (ALARM_LED_PIN < 0) return;
  bool on;
  if      (topPrio >= PRIO_CRIT) on = (now / 125) & 1;   // 4 Hz flash
  else if (topPrio == PRIO_HIGH) on = (now / 500) & 1;   // 1 Hz flash
  else if (topPrio == PRIO_LOW)  on = true;              // steady
  else                           on = false;
  digitalWrite(ALARM_LED_PIN, on ? HIGH : LOW);
}

// =====================================================================
//  SETUP
// =====================================================================
void setup() {
  Serial.setTxBufferSize(1024);           // logging never blocks the sensor task
  Serial.begin(115200);
  delay(300);
  Serial.println();
  Serial.println(F("=============================================="));
  Serial.println(F(" MedMonitor v3.4 — ESP32 patient vitals monitor"));
  Serial.println(F(" PROTOTYPE — not a certified medical device"));
  Serial.println(F(" Battery power only while electrodes are on a person"));
  Serial.println(F("=============================================="));
  Serial.printf("[BOOT] Reset reason: %s\n", resetReasonText(esp_reset_reason()));
  if (strcmp(DASH_PASS, DASH_PASS_DEFAULT) == 0) {
    Serial.println(F("[SEC]  WARNING: default dashboard password — change DASH_PASS!"));
  }

  pinMode(LO_PLUS_PIN, INPUT_PULLUP);
  pinMode(LO_MINUS_PIN, INPUT_PULLUP);
  analogReadResolution(12);
  analogSetPinAttenuation(ECG_OUTPUT_PIN, ADC_11db);
  if (ALARM_LED_PIN >= 0) { pinMode(ALARM_LED_PIN, OUTPUT); digitalWrite(ALARM_LED_PIN, LOW); }

  dht.begin();
  ds18b20.begin();
  ds18b20.setWaitForConversion(false);

  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);
  Wire.setClock(I2C_CLOCK_HZ);
  Wire.setTimeOut(I2C_TIMEOUT_MS);
  i2cScanReport();
  poInit(millis());                       // last I2C use outside the sensor task

  prefs.begin("patient", false);
  prefsLog.begin("log", false);
  g_log.fsOk = LittleFS.begin(true);      // formats the partition on first use
  if (g_log.fsOk) {
    Serial.printf("[LOG] Flash filesystem: %lu KB free of %lu KB\n",
                  (unsigned long)((LittleFS.totalBytes() - LittleFS.usedBytes()) / 1024),
                  (unsigned long)(LittleFS.totalBytes() / 1024));
    logRestoreAtBoot();
  } else {
    Serial.println(F("[LOG] No flash filesystem! Tools > Partition Scheme: pick one with SPIFFS (e.g. Default 4MB with spiffs)"));
  }

  g_ecgMsg.reserve(96);
  g_vMsg.reserve(112);
  g_aMsg.reserve(96);

  ecgQueue = xQueueCreate(ECG_QUEUE_LEN, sizeof(int16_t));
  if (ecgQueue == nullptr) {
    Serial.println(F("[FATAL] ECG queue allocation failed — restarting."));
    delay(1000);
    ESP.restart();
  }

  watchdogInit();
  // Core 1 (same as loop) at higher priority -> preempts loop() every 4 ms.
  xTaskCreatePinnedToCore(sensorTask, "sensors", 6144, nullptr, 3, &g_sensorTask, 1);

  startWiFi();
  snprintf(g_wsToken, sizeof g_wsToken, "%08lx%08lx",
           (unsigned long)esp_random(), (unsigned long)esp_random());   // per-boot WS token

  server.on("/", handleRoot);
  server.on("/api/token", HTTP_GET, handleToken);
  server.on("/api/patient", HTTP_GET, handlePatientGet);
  server.on("/api/patient", HTTP_POST, handlePatientPost);
  server.on("/api/log/start",  HTTP_POST, handleLogStart);
  server.on("/api/log/stop",   HTTP_POST, handleLogStop);
  server.on("/api/log/status", HTTP_GET,  handleLogStatus);
  server.on("/api/log.csv",    HTTP_GET,  handleLogDownload);
  server.onNotFound(handleNotFound);
  server.begin();
  webSocket.begin();
  webSocket.onEvent(webSocketEvent);
  webSocket.enableHeartbeat(15000, 3000, 2);

  esp_task_wdt_add(NULL);                 // watch loop() too (setup runs in loopTask)
}

// =====================================================================
//  LOOP — networking, slow sensors, alarms
// =====================================================================
unsigned long lastVitals = 0, lastDht = 0, lastTemp = 0, lastAlarmEval = 0;
unsigned long lastAlarmSend = 0, lastStats = 0, lastNoViewerWarn = 0, lastPulseUpd = 0;
uint32_t sentBeatCount = 0, sentQrsCount = 0;
bool     sentLeadOff = true;
uint8_t  sentLeadReason = 0xFF;
uint8_t  g_topPrio = 0;

void loop() {
  esp_task_wdt_reset();
  server.handleClient();
  webSocket.loop();
  serviceWiFi();

  const unsigned long now = millis();
  wsHousekeeping(now);

  // ---------- ECG: forward in batches ----------
  const uint32_t waiting = uxQueueMessagesWaiting(ecgQueue);
  if (waiting > g_queueMax) g_queueMax = waiting;
  const bool viewers = wsAuthedCount() > 0;
  while (uxQueueMessagesWaiting(ecgQueue) >= ECG_BATCH) {
    g_ecgMsg = "E:";
    for (int i = 0; i < ECG_BATCH; i++) {
      int16_t s;
      if (xQueueReceive(ecgQueue, &s, 0) != pdTRUE) break;
      if (i) g_ecgMsg += ',';
      g_ecgMsg += (int)s;
    }
    if (viewers) wsSendAll(g_ecgMsg);
  }

  // ---------- Lead state ----------
  const bool    leadOff    = s_leadOff;
  const uint8_t leadReason = s_leadReason;
  if (leadOff != sentLeadOff || leadReason != sentLeadReason) {
    if (leadOff != sentLeadOff) {
      Serial.printf("[ECG] %s (reason 0x%02X: %s%s%s)\n",
                    leadOff ? "Electrodes OFF / lead fault" : "Electrodes connected", leadReason,
                    (leadReason & LEAD_LO_PLUS)   ? "LO+ high " : "",
                    (leadReason & LEAD_LO_MINUS)  ? "LO- high " : "",
                    (leadReason & LEAD_SATURATED) ? "output saturated" : "");
    }
    sentLeadOff = leadOff;
    sentLeadReason = leadReason;
    buildLeadMsg(leadOff, leadReason);
    wsSendAll(g_lMsg);
  }

  // ---------- Heart blink: follows the source of the Heart Rate card ----------
  const uint32_t q = s_qrsCount, b = s_beatCount;
#if HR_FROM_PULSE_OX
  const bool ecgBlink = g_pulse == 0 && HR_FALLBACK_TO_ECG && g_ecgHr > 0;
#else
  const bool ecgBlink = g_ecgHr > 0;
#endif
  if (q != sentQrsCount)  { sentQrsCount  = q; if (ecgBlink)  { g_bMsg = "B:"; wsSendAll(g_bMsg); } }
  if (b != sentBeatCount) { sentBeatCount = b; if (!ecgBlink) { g_bMsg = "B:"; wsSendAll(g_bMsg); } }

  // ---------- Stable pulse rate / SpO2 (1 Hz, before alarms use them) ----------
  if (now - lastPulseUpd >= 1000) {
    lastPulseUpd = now;
    updatePulseDisplay();
  }

  // ---------- DHT11 (max 1 read / 2 s) ----------
  if (now - lastDht >= DHT_INTERVAL) {
    lastDht = now;
    const float h = dht.readHumidity();
    const float t = dht.readTemperature();
    if (!isnan(h) && !isnan(t)) { g_humidity = h; g_roomTemp = t; g_dhtLastOkMs = now; }
  }
  if (g_dhtLastOkMs && now - g_dhtLastOkMs > SENSOR_STALE_MS) { g_humidity = 0; g_roomTemp = 0; }

  // ---------- DS18B20 (async) ----------
  if (now - lastTemp >= TEMP_INTERVAL) {
    lastTemp = now;
    ds18b20.requestTemperatures();
    const float t = ds18b20.getTempCByIndex(0);
    if (t != DEVICE_DISCONNECTED_C && t > 0 && t < 80) {   // 85.0 = power-on value, rejected
      g_temperature = t + BODY_TEMP_OFFSET_C;
      g_tempLastOkMs = now;
    }
  }
  if (g_tempLastOkMs && now - g_tempLastOkMs > SENSOR_STALE_MS) g_temperature = 0;

  // ---------- Alarms (4 Hz) ----------
  if (now - lastAlarmEval >= ALARM_EVAL_MS) {
    lastAlarmEval = now;
    computeVitals();
    g_topPrio = evaluateAlarms();
    buildAlarmMsg(millis());
    if (g_forceAlarmSend || g_aMsg != g_lastAMsg || now - lastAlarmSend >= ALARM_RESEND_MS) {
      g_forceAlarmSend = false;
      g_lastAMsg = g_aMsg;
      lastAlarmSend = now;
      wsSendAll(g_aMsg);
    }
    if (g_topPrio >= PRIO_HIGH && wsAuthedCount() == 0 && now - lastNoViewerWarn >= 10000) {
      lastNoViewerWarn = now;
      Serial.println(F("[ALARM] !!! Alarm active and NO dashboard connected !!!"));
    }
  }
  updateAlarmLed(g_topPrio, now);

  // ---------- 1 Hz vitals ----------
  if (now - lastVitals >= VITALS_INTERVAL) {
    lastVitals = now;
    g_vMsg = "V:";
    g_vMsg += g_hr;                     g_vMsg += ',';
    g_vMsg += g_spo2;                   g_vMsg += ',';
    g_vMsg += String(g_temperature, 1); g_vMsg += ',';
    g_vMsg += String(g_roomTemp, 1);    g_vMsg += ',';
    g_vMsg += String(g_humidity, 1);    g_vMsg += ',';
    g_vMsg += leadOff ? '1' : '0';      g_vMsg += ',';
    g_vMsg += g_ecgHr;                  g_vMsg += ',';
    g_vMsg += g_pulse;                  g_vMsg += ',';
    g_vMsg += (int)leadReason;          g_vMsg += ',';
    g_vMsg += (int)s_poState;           g_vMsg += ',';
    g_vMsg += (int)s_poQuality;         g_vMsg += ',';
    g_vMsg += (int)lroundf(s_poPi * 10.0f);   // PI x 10
    wsSendAll(g_vMsg);
    Serial.printf("[VITALS] HR=%d (pulse %d, ECG %d)  SpO2=%d%%  Skin=%.1fC  Room=%.1fC  RH=%.0f%%\n",
                  g_hr, g_pulse, g_ecgHr, g_spo2, g_temperature, g_roomTemp, g_humidity);
    {
      static const char* const ST[] = {"SENSOR MISSING", "NO FINGER", "ADJUSTING", "WEAK/MOTION", "GOOD"};
      const uint8_t st = s_poState;
      Serial.printf("[PPG] %s %-14s IR %4.1fmA DC %3.0f%% | RED %4.1fmA DC %3.0f%% | PI %.2f%% q=%.2f HR=%.1f R=%.3f SpO2=%.1f\n",
                    s_poChip == PO_CHIP_30100 ? "MAX30100" : s_poChip == PO_CHIP_30102 ? "MAX30102" : "--------",
                    ST[st < 5 ? st : 0], (float)s_poIrMa, (float)s_poIrDc * 100.0f,
                    (float)s_poRedMa, (float)s_poRedDc * 100.0f, (float)s_poPi,
                    s_poQuality / 100.0f, (float)s_poHr, (float)s_poR, (float)s_poSpo2);
    }
    // ECG diagnostics: healthy = LO+=0 LO-=0, avg ~1500-2500, span > 200, pinned 0 %
    Serial.printf("[ECGDIAG] leads=%s LO+=%d LO-=%d raw min/avg/max=%u/%u/%u span=%u pinned=%u%% qrs=%lu%s%s\n",
                  leadOff ? "OFF" : "on",
                  (leadReason & LEAD_LO_PLUS) ? 1 : 0, (leadReason & LEAD_LO_MINUS) ? 1 : 0,
                  (unsigned)s_dbgRawMin, (unsigned)s_dbgRawAvg, (unsigned)s_dbgRawMax,
                  (unsigned)(s_dbgRawMax - s_dbgRawMin), (unsigned)s_dbgPinnedPct,
                  (unsigned long)s_qrsCount,
                  (leadReason & LEAD_LO_IGNORED) ? "  [LO ignored: ECG present]" : "",
                  (leadReason & LEAD_CLIPPING)   ? "  [CLIPPING]" : "");
  }

  // ---------- Data logging ----------
  logService(now);

  // ---------- 60 s health statistics ----------
  if (now - lastStats >= STATS_INTERVAL_MS) {
    lastStats = now;
    Serial.printf("[STATS] heap=%u B  sensorStackFree=%u B  ecgQueueMax=%lu/%d  ecgDrops=%lu  slowClients=%lu  viewers=%u\n",
                  (unsigned)ESP.getFreeHeap(),
                  (unsigned)uxTaskGetStackHighWaterMark(g_sensorTask),
                  (unsigned long)g_queueMax, ECG_QUEUE_LEN,
                  (unsigned long)s_ecgDrops, (unsigned long)g_slowClientDrops,
                  (unsigned)wsAuthedCount());
    g_queueMax = 0;
  }

  vTaskDelay(1);   // let IDLE run on core 1
}
