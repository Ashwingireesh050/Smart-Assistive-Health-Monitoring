<script>
/* ================= CLOCK ================= */
setInterval(() => {
  document.getElementById('clockTop').textContent = new Date().toLocaleTimeString();
}, 1000);

/* ================= PAGE NAVIGATION ================= */
let currentPage = 'dashboard';
function showPage(page) {
  document.querySelectorAll('.nav-link').forEach(l => l.classList.toggle('active', l.dataset.page === page));
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-' + page).classList.add('active');
  currentPage = page;
  if (page === 'patient') fetchPatient();
  if (page === 'logging') logRefresh();
}
document.querySelectorAll('.nav-link').forEach(link => {
  link.addEventListener('click', () => showPage(link.dataset.page));
});

/* ================= ECG CANVAS ================= */
// Samples arrive filtered (0.5–40 Hz + mains notch) on the ESP32, in µV
// referred to the electrodes, 250 Hz, batches of 10. 1000 points = 4 s.
const canvas = document.getElementById('ecg');
const ctx = canvas.getContext('2d');
const ECG_FS = 250;
const MAX_POINTS = 1000;
const PX_PER_SEC = canvas.width / (MAX_POINTS / ECG_FS);   // 450 px/s
const data = new Float32Array(MAX_POINTS);                   // ring buffer
let head = 0;
let gain = 0.06;                                             // px per µV (auto)

let leadOffUI = false;
let lastDataMs = 0;
let dirty = false;
let lastDrawMs = 0;

function pushSample(v) { data[head] = v; head = (head + 1) % MAX_POINTS; }

function drawGrid() {
  ctx.fillStyle = '#0a0f1f';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  const minor = PX_PER_SEC * 0.04, major = PX_PER_SEC * 0.2;   // ECG paper: 1 mm / 5 mm
  ctx.lineWidth = 1;
  ctx.strokeStyle = 'rgba(34, 197, 94, 0.08)';
  for (let x = 0; x < canvas.width; x += minor) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke(); }
  for (let y = 0; y < canvas.height; y += minor) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke(); }
  ctx.strokeStyle = 'rgba(34, 197, 94, 0.2)';
  for (let x = 0; x < canvas.width; x += major) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke(); }
  for (let y = 0; y < canvas.height; y += major) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke(); }
}

function drawScaleBar(half) {
  let mv = 1;
  if (1000 * gain > canvas.height - 30) mv = 0.5;
  if (mv * 1000 * gain > canvas.height - 30) mv = 0.2;
  const h = mv * 1000 * gain;
  const x = 18, top = half - h / 2, bot = half + h / 2;
  ctx.strokeStyle = '#e2e8f0'; ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(x - 6, bot); ctx.lineTo(x, bot); ctx.lineTo(x, top); ctx.lineTo(x + 6, top);
  ctx.stroke();
  ctx.fillStyle = '#e2e8f0'; ctx.font = 'bold 14px Courier New, monospace'; ctx.textAlign = 'left';
  ctx.fillText(mv + ' mV', x + 10, top + 5);
}

function draw() {
  drawGrid();

  // Auto-gain, but never amplify a near-flat trace (noise must not look like beats).
  let mn = Infinity, mx = -Infinity;
  for (let i = 0; i < MAX_POINTS; i++) { const v = data[i]; if (v < mn) mn = v; if (v > mx) mx = v; }
  const p2p = mx - mn;
  let target = 0.06;                    // 1 mV = 60 px when there is no signal
  if (p2p > 100) {                      // > 100 µV peak-to-peak
    target = (canvas.height * 0.75) / p2p;
    if (target > 0.6) target = 0.6;
    if (target < 0.01) target = 0.01;
  }
  gain += (target - gain) * 0.08;

  const half = canvas.height / 2;
  const mid = (mx + mn) / 2;
  ctx.strokeStyle = '#22c55e';
  ctx.lineWidth = 2.2;
  ctx.shadowColor = '#22c55e';
  ctx.shadowBlur = 8;
  ctx.beginPath();
  for (let i = 0; i < MAX_POINTS; i++) {
    const v = data[(head + i) % MAX_POINTS];
    const x = (i / MAX_POINTS) * canvas.width;
    let y = half - (v - mid) * gain;
    if (y < 6) y = 6;
    if (y > canvas.height - 6) y = canvas.height - 6;
    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
  }
  ctx.stroke();
  ctx.shadowBlur = 0;
  drawScaleBar(half);

  if (leadOffUI) {
    const [l1, l2] = leadOffDetail(leadReason);
    ctx.fillStyle = 'rgba(10, 15, 31, 0.85)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.textAlign = 'center';
    ctx.fillStyle = '#ef4444';
    ctx.font = 'bold 34px Courier New, monospace';
    ctx.fillText(l1, canvas.width / 2, half - 12);
    ctx.fillStyle = '#fbbf24';
    ctx.font = 'bold 22px Courier New, monospace';
    ctx.fillText(l2, canvas.width / 2, half + 26);
  } else if (Date.now() - lastDataMs > 700) {
    ctx.fillStyle = 'rgba(10, 15, 31, 0.85)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.textAlign = 'center';
    ctx.fillStyle = '#fbbf24';
    ctx.font = 'bold 30px Courier New, monospace';
    ctx.fillText('NO ECG DATA — check monitor connection', canvas.width / 2, half + 10);
  }
}

function animLoop() {
  const t = Date.now();
  if (dirty || t - lastDrawMs > 300) { draw(); lastDrawMs = t; dirty = false; }
  requestAnimationFrame(animLoop);
}
requestAnimationFrame(animLoop);

/* ================= WEBSOCKET (token auth + auto-reconnect) ================= */
let ws = null;
let lastMsgMs = Date.now();

async function connectWS() {
  let token;
  try {
    const r = await fetch('/api/token', { cache: 'no-store' });
    if (!r.ok) throw new Error('token ' + r.status);
    token = (await r.text()).trim();
  } catch (e) { setTimeout(connectWS, 2000); return; }
  ws = new WebSocket('ws://' + location.hostname + ':81/');
  ws.onopen = () => ws.send('T:' + token);
  ws.onmessage = (e) => { lastMsgMs = Date.now(); handleWSMessage(e.data); };
  ws.onclose = () => setTimeout(connectWS, 2000);
  ws.onerror = () => { try { ws.close(); } catch (err) {} };
}
function wsSend(s) { if (ws && ws.readyState === 1) { ws.send(s); return true; } return false; }

function handleWSMessage(msg) {
  if (!msg || msg.length < 2) return;
  const tag = msg.substring(0, 2);

  if (tag === 'E:') {                     // ECG batch (µV)
    const parts = msg.substring(2).split(',');
    for (let i = 0; i < parts.length; i++) { const v = parseInt(parts[i], 10); if (!isNaN(v)) pushSample(v); }
    lastDataMs = Date.now(); dirty = true;
    return;
  }
  if (tag === 'L:') {                     // "L:<off>:<reason bits>"
    leadOffUI = (msg.charAt(2) === '1');
    leadReason = parseInt(msg.substring(4), 10) || 0;
    updateLeadPill(); dirty = true;
    return;
  }
  if (tag === 'B:') { blinkHeart(); return; }
  if (tag === 'A:') { handleAlarmMsg(msg.substring(2)); return; }
  if (tag === 'V:') {                     // vitals snapshot (1 Hz)
    const p = msg.substring(2).split(',');
    if (p.length < 12) return;
    leadReason = parseInt(p[8], 10) || 0;
    poState = parseInt(p[9], 10) || 0;
    poQuality = parseInt(p[10], 10) || 0;
    poPi = (parseInt(p[11], 10) || 0) / 10;
    updateVitals(parseInt(p[0]), parseInt(p[1]), parseFloat(p[2]), parseFloat(p[3]),
                 parseFloat(p[4]), p[5] === '1', parseInt(p[6]), parseInt(p[7]));
  }
}

/* ================= UI UPDATE ================= */
// Pulse-sensor state — must match PO_* in the firmware
const PO_MISSING = 0, PO_NOFINGER = 1, PO_ADJUSTING = 2, PO_WEAK = 3, PO_GOOD = 4;
let poState = PO_MISSING, poQuality = 0, poPi = 0;
function poStatusText() {
  switch (poState) {
    case PO_MISSING:   return 'Pulse sensor not detected — check wiring';
    case PO_NOFINGER:  return 'Place fingertip on the sensor';
    case PO_ADJUSTING: return 'Adjusting light… hold still';
    case PO_WEAK:      return 'Weak signal or movement — hold still';
    default:           return 'Measuring…';
  }
}

// Lead-off reason bits — must match LEAD_* in the firmware
const LEAD_LO_PLUS = 1, LEAD_LO_MINUS = 2, LEAD_SATURATED = 4, LEAD_CLIPPING = 8, LEAD_LO_IGNORED = 16;
let leadReason = LEAD_LO_PLUS | LEAD_LO_MINUS;

function leadOffDetail(r) {
  if (r & LEAD_SATURATED) return ['⚠  AMPLIFIER SATURATED', 'Check RL (right-leg) electrode & skin contact, keep still'];
  if ((r & LEAD_LO_PLUS) && (r & LEAD_LO_MINUS)) return ['⚠  ELECTRODES NOT CONNECTED', 'LO+ and LO− high: attach RA, LA and RL electrodes'];
  if (r & LEAD_LO_PLUS)  return ['⚠  LA ELECTRODE NOT DETECTED', 'LO+ high (+IN): check LA electrode, gel and cable'];
  if (r & LEAD_LO_MINUS) return ['⚠  RA ELECTRODE NOT DETECTED', 'LO− high (−IN): check RA electrode, gel and cable'];
  return ['⚠  ECG SIGNAL LOST', 'Check electrodes and cable'];
}

function updateLeadPill() {
  const pill = document.getElementById('leadPill');
  const nav  = document.getElementById('navLive');
  if (leadOffUI) {
    pill.textContent = 'LEADS OFF'; pill.classList.add('off');
    nav.textContent  = 'LEADS OFF'; nav.classList.add('off');
  } else {
    let t = 'LIVE';
    if (leadReason & LEAD_CLIPPING)   t += ' • CLIPPING';
    if (leadReason & LEAD_LO_IGNORED) t += ' • CHECK ELECTRODE GEL';
    pill.textContent = t; pill.classList.remove('off');
    nav.textContent  = 'LIVE';  nav.classList.remove('off');
  }
}

function blinkHeart() {
  const el = document.getElementById('bpmIcon');
  if (!el) return;
  el.classList.add('beat');
  setTimeout(() => el.classList.remove('beat'), 140);
}

function applyVital(name, value, classify, normalRange, noSigRange) {
  const badge = document.getElementById(name + 'Status');
  const card  = document.getElementById('card' + name[0].toUpperCase() + name.slice(1));
  const range = document.getElementById(name + 'Range');
  let level;
  if (value === 0 || isNaN(value)) {
    level = 'nosig';
    if (range && noSigRange) range.textContent = noSigRange;
  } else {
    level = classify(value);
    if (range) range.textContent = normalRange;
  }
  badge.className = 'status-badge status-' + level;
  badge.textContent = level === 'nosig' ? 'NO SIG' : level === 'normal' ? 'NORMAL' : level.toUpperCase();
  card.classList.remove('warn', 'danger');
  if (level === 'warn')   card.classList.add('warn');
  if (level === 'danger') card.classList.add('danger');
}

function updateVitals(bpm, spo2, temp, room, humid, leadOff, ecgHr, pulseHr) {
  leadOffUI = leadOff;
  updateLeadPill();

  document.getElementById('bpmVal').textContent   = bpm  > 0 ? bpm  : '--';
  document.getElementById('spo2Val').textContent  = spo2 > 0 ? spo2 : '--';
  document.getElementById('tempVal').textContent  = temp > 0 ? temp.toFixed(1) : '--';
  document.getElementById('roomVal').textContent  = room > 0 ? room.toFixed(1) : '--';
  document.getElementById('humidVal').textContent = humid > 0 ? humid.toFixed(1) : '--';
  document.getElementById('ecgHrTag').textContent = ecgHr > 0 ? '• ' + ecgHr + ' bpm' : '';

  // Card value = stabilised pulse-oximeter rate (ECG rate only as reference)
  let src;
  if (pulseHr > 0)    src = 'Pulse oximeter' + (ecgHr > 0 ? ' • ECG ' + ecgHr : '');
  else if (bpm > 0)   src = 'From ECG (no finger on sensor)';
  else                src = '60 – 100 BPM';
  const sigText = poState === PO_GOOD
    ? 'Signal good • PI ' + poPi.toFixed(1) + '%'
    : (poState === PO_WEAK || poState === PO_ADJUSTING ? poStatusText() + ' (last value)' : poStatusText());

  applyVital('bpm', bpm,
    v => (v < 50 || v > 120) ? 'danger' : ((v < 60 || v > 100) ? 'warn' : 'normal'),
    poState === PO_GOOD ? src : (pulseHr > 0 ? sigText : src), poStatusText());
  applyVital('spo2', spo2,
    v => v < 90 ? 'danger' : (v < 95 ? 'warn' : 'normal'),
    poState === PO_GOOD ? '95 – 100% • ' + sigText : sigText, poStatusText());
  applyVital('temp', temp,
    v => (v > 39 || v < 35) ? 'danger' : ((v > 37.5 || v < 36) ? 'warn' : 'normal'),
    '36.1 – 37.2 °C', 'Temperature probe not reading');
  applyVital('room', room,
    v => (v > 32 || v < 15) ? 'danger' : ((v > 28 || v < 18) ? 'warn' : 'normal'),
    '20 – 26 °C', null);
  applyVital('humid', humid,
    v => (v > 80 || v < 20) ? 'danger' : ((v > 65 || v < 30) ? 'warn' : 'normal'),
    '30 – 60 %', null);
}

/* ================= ALARMS (evaluated on the monitor) ================= */
// Order MUST match the AlarmId enum in the firmware.
const ALARM_TEXT = [
  'ASYSTOLE — no QRS detected for 4 s',
  'HEART RATE CRITICALLY LOW (< 40 bpm)',
  'HEART RATE CRITICALLY HIGH (> 200 bpm)',
  'SpO₂ CRITICALLY LOW (< 88 %)',
  'HIGH TEMPERATURE (> 39.5 °C)',
  'LOW TEMPERATURE (< 31 °C)',
  'ECG LEADS OFF — reattach electrodes',
  'NO PULSE SIGNAL — check finger sensor',
  'PULSE OXIMETER DISCONNECTED',
  'TEMPERATURE PROBE DISCONNECTED',
];
let alarms = [];
let standby = false;
let connLost = false;

function handleAlarmMsg(s) {
  const bar = s.indexOf('|');
  standby = s.substring(0, bar) === '1';
  alarms = s.substring(bar + 1).split(';').filter(x => x).map(e => {
    const f = e.split(',').map(Number);
    return { id: f[0], prio: f[1], silenced: f[2] === 1 };
  });
  alarms.sort((a, b) => b.prio - a.prio);
  renderAlarms();
}

function renderAlarms() {
  const bar = document.getElementById('alarmBar');
  bar.textContent = '';
  const add = (cls, text, ackId) => {
    const d = document.createElement('div');
    d.className = 'alarm-chip ' + cls;
    const s = document.createElement('span');
    s.textContent = text;
    d.appendChild(s);
    if (ackId !== undefined) {
      const b = document.createElement('button');
      b.textContent = 'ACK';
      b.onclick = () => ackAlarm(ackId);
      d.appendChild(b);
    }
    bar.appendChild(d);
  };
