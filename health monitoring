// =====================================================================
//  DATA LOGGING — CSV on the ESP32's flash (LittleFS)
//  Runs on the monitor, so recording continues when the browser closes.
//  Rows are buffered in RAM and written in blocks of LOG_FLUSH_ROWS to
//  keep flash writes (which briefly pause both CPU cores) infrequent.
// =====================================================================
struct LogState {
  bool     fsOk = false, running = false;
  uint16_t intervalS = 1;
  uint32_t rows = 0, bytes = 0, durationS = 0;
  uint32_t startMs = 0, nextRowMs = 0;
  int64_t  baseEpochMs = 0;      // browser clock at Start (no RTC on board)
  int32_t  tzOffsetMin = 330;    // minutes east of UTC (IST = +330)
  String   buf;                  // rows not yet written to flash
  uint8_t  bufRows = 0;
  String   startedAt, reason;
} g_log;
String  g_logRecent[LOG_RECENT_N];
uint8_t g_logRecentIdx = 0, g_logRecentN = 0;

static const char* const LOG_HEADER =
  "timestamp,elapsed_s,heart_rate_bpm,pulse_ox_hr_bpm,ecg_hr_bpm,spo2_pct,"
  "skin_temp_c,room_temp_c,humidity_pct,ecg_leads,alarms\r\n";

static void logSaveMeta() {
  prefsLog.putString("started", g_log.startedAt);
  prefsLog.putUShort("interval", g_log.intervalS);
  prefsLog.putBool("running", g_log.running);
  prefsLog.putString("reason", g_log.reason);
  prefsLog.putULong("duration", g_log.durationS);
}

static void logTimestamp(uint32_t nowMs, char* out, size_t n) {
  const int64_t epochMs = g_log.baseEpochMs + (int64_t)(uint32_t)(nowMs - g_log.startMs);
  time_t local = (time_t)(epochMs / 1000) + (time_t)g_log.tzOffsetMin * 60;
  struct tm tmv;
  gmtime_r(&local, &tmv);
  strftime(out, n, "%Y-%m-%d %H:%M:%S", &tmv);
}

static void logStop(const char* why);

static void logFlush() {
  if (!g_log.buf.length()) return;
  File f = LittleFS.open(LOG_PATH, FILE_APPEND);
  if (!f) { g_log.buf = ""; g_log.bufRows = 0; logStop("flash write error"); return; }
  const size_t n = f.print(g_log.buf);
  f.close();
  g_log.bytes += n;
  g_log.buf = "";
  g_log.bufRows = 0;
  if (g_log.bytes >= LOG_MAX_BYTES) logStop("storage full — download, then start a new log");
}

static void logStop(const char* why) {
  if (!g_log.running) return;
  g_log.running = false;                 // set first: logFlush() may call back here
  logFlush();
  g_log.durationS = (millis() - g_log.startMs) / 1000;
  g_log.reason = why;
  logSaveMeta();
  Serial.printf("[LOG] Stopped: %s (%lu rows, %lu bytes)\n", why,
                (unsigned long)g_log.rows, (unsigned long)g_log.bytes);
}

static void csvInt(String& s, int v)     { s += ','; if (v > 0) s += v; }
static void csvF1(String& s, float v)    { s += ','; if (v > 0) s += String(v, 1); }

static void logWriteRow(uint32_t now) {
  char ts[24];
  logTimestamp(now, ts, sizeof ts);
  String line;
  line.reserve(128);
  line += ts;
  line += ',';
  line += (unsigned long)((now - g_log.startMs) / 1000);
  csvInt(line, g_hr);
  csvInt(line, g_pulse);
  csvInt(line, g_ecgHr);
  csvInt(line, g_spo2);
  csvF1(line, g_temperature);
  csvF1(line, g_roomTemp);
  csvF1(line, g_humidity);
  line += ',';
  line += s_leadOff ? "off" : "on";
  line += ',';
  bool first = true;
  if (g_standby) { line += "STANDBY"; first = false; }
  for (uint8_t i = 0; i < AL_COUNT; i++) {
    if (!g_al[i].active) continue;
    if (!first) line += '|';             // '|' keeps the CSV to one column
    line += ALARM_DEFS[i].name;
    first = false;
  }

  g_logRecent[g_logRecentIdx] = line;
  g_logRecentIdx = (uint8_t)((g_logRecentIdx + 1) % LOG_RECENT_N);
  if (g_logRecentN < LOG_RECENT_N) g_logRecentN++;

  g_log.buf += line;
  g_log.buf += "\r\n";
  g_log.bufRows++;
  g_log.rows++;
  if (g_log.bufRows >= LOG_FLUSH_ROWS || g_log.intervalS >= 10) logFlush();
}

static void logService(uint32_t now) {
  if (!g_log.running) return;
  if ((int32_t)(now - g_log.nextRowMs) < 0) return;
  logWriteRow(now);
  const uint32_t iv = (uint32_t)g_log.intervalS * 1000UL;
  g_log.nextRowMs += iv;
  if ((int32_t)(now - g_log.nextRowMs) > (int32_t)iv) g_log.nextRowMs = now + iv;  // fell behind: resync
}

// Count rows of a log left over from before a reboot.
static void logRestoreAtBoot() {
  if (!g_log.fsOk || !LittleFS.exists(LOG_PATH)) return;
  File f = LittleFS.open(LOG_PATH, "r");
  if (!f) return;
  g_log.bytes = f.size();
  uint32_t lines = 0;
  uint8_t chunk[256];
  while (f.available()) {
    const int n = f.read(chunk, sizeof chunk);
    if (n <= 0) break;
    for (int i = 0; i < n; i++) if (chunk[i] == '\n') lines++;
    esp_task_wdt_reset();
  }
  f.close();
  g_log.rows      = lines > 0 ? lines - 1 : 0;   // minus header
  g_log.startedAt = prefsLog.getString("started", "");
  g_log.intervalS = prefsLog.getUShort("interval", 1);
  g_log.durationS = prefsLog.getULong("duration", 0);
  g_log.reason    = prefsLog.getString("reason", "");
  if (prefsLog.getBool("running", false)) {
    g_log.reason = "device restarted while recording";
    g_log.durationS = g_log.rows * g_log.intervalS;
    prefsLog.putBool("running", false);
    prefsLog.putString("reason", g_log.reason);
    prefsLog.putULong("duration", g_log.durationS);
  }
  Serial.printf("[LOG] Previous log on flash: %lu rows, %lu bytes\n",
                (unsigned long)g_log.rows, (unsigned long)g_log.bytes);
}

void handleLogStart() {
  if (!requireAuth()) return;
  if (!g_log.fsOk) { server.send(500, "text/plain", "No flash filesystem — select a partition scheme with SPIFFS/LittleFS"); return; }
  if (g_log.running) { server.send(409, "text/plain", "Already recording"); return; }

  const uint16_t iv = (uint16_t)server.arg("interval").toInt();
  bool ivOk = false;
  for (size_t i = 0; i < sizeof(LOG_INTERVALS) / sizeof(LOG_INTERVALS[0]); i++) if (iv == LOG_INTERVALS[i]) ivOk = true;
  if (!ivOk) { server.send(400, "text/plain", "Invalid interval"); return; }
  const long long epoch = strtoll(server.arg("epoch").c_str(), nullptr, 10);
  if (epoch < 1600000000000LL || epoch > 4100000000000LL) { server.send(400, "text/plain", "Invalid clock from browser"); return; }
  long tz = server.arg("tz").toInt();
  if (tz < -720 || tz > 840) tz = 330;

  File f = LittleFS.open(LOG_PATH, FILE_WRITE);          // replaces the previous log
  if (!f) { server.send(500, "text/plain", "Cannot create log file"); return; }
  const size_t n = f.print(LOG_HEADER);
  f.close();

  const uint32_t now = millis();
  g_log.intervalS   = iv;
  g_log.baseEpochMs = epoch;
  g_log.tzOffsetMin = (int32_t)tz;
  g_log.startMs     = now;
  g_log.nextRowMs   = now;                                // first row immediately
  g_log.rows = 0; g_log.bytes = n; g_log.durationS = 0;
  g_log.buf = ""; g_log.bufRows = 0;
  g_log.reason = "";
  g_logRecentN = g_logRecentIdx = 0;
  char ts[24];
  logTimestamp(now, ts, sizeof ts);
  g_log.startedAt = ts;
  g_log.running = true;
  logSaveMeta();
  Serial.printf("[LOG] Started at %s, every %u s\n", ts, iv);
  server.send(200, "text/plain", "OK");
}

void handleLogStop() {
  if (!requireAuth()) return;
  logStop("stopped by user");
  server.send(200, "text/plain", "OK");
}

void handleLogStatus() {
  if (!requireAuth()) return;
  const uint32_t elapsed = g_log.running ? (millis() - g_log.startMs) / 1000 : g_log.durationS;
  String j = "{";
  j += "\"fs\":";       j += g_log.fsOk ? "true" : "false";
  j += ",\"running\":"; j += g_log.running ? "true" : "false";
  j += ",\"interval\":"; j += g_log.intervalS;
  j += ",\"rows\":";    j += (unsigned long)g_log.rows;
  j += ",\"bytes\":";   j += (unsigned long)(g_log.bytes + g_log.buf.length());
  j += ",\"max\":";     j += (unsigned long)LOG_MAX_BYTES;
  j += ",\"elapsed\":"; j += (unsigned long)elapsed;
  jsonField(j, "started", g_log.startedAt, true);
  jsonField(j, "reason", g_log.reason, true);
  j += ",\"recent\":[";
  for (uint8_t k = 0; k < g_logRecentN; k++) {            // newest first
    const uint8_t idx = (uint8_t)((g_logRecentIdx + LOG_RECENT_N - 1 - k) % LOG_RECENT_N);
    if (k) j += ',';
    jsonEscape(j, g_logRecent[idx]);
  }
  j += "]}";
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", j);
}

void handleLogDownload() {
  if (!requireAuth()) return;
  if (g_log.running) logFlush();                          // include the newest rows
  if (!g_log.fsOk || !LittleFS.exists(LOG_PATH)) { server.send(404, "text/plain", "No log recorded yet"); return; }
  File f = LittleFS.open(LOG_PATH, "r");
  if (!f) { server.send(500, "text/plain", "Cannot open log"); return; }

  // medmonitor_<patientId>_<YYYYMMDD_HHMMSS>.csv
  String pid = prefs.getString("pid", ""), safe, stamp;
  for (size_t i = 0; i < pid.length() && safe.length() < 24; i++) {
    const char c = pid[i];
    if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_') safe += c;
  }
  for (size_t i = 0; i < g_log.startedAt.length(); i++) {
    const char c = g_log.startedAt[i];
    if (c >= '0' && c <= '9') stamp += c;
    else if (c == ' ') stamp += '_';
  }
  String name = "medmonitor";
  if (safe.length())  { name += '_'; name += safe; }
  if (stamp.length()) { name += '_'; name += stamp; }
  name += ".csv";

  server.sendHeader("Content-Disposition", "attachment; filename=\"" + name + "\"");
  server.sendHeader("Cache-Control", "no-store");
  server.streamFile(f, "text/csv");
  f.close();
}

