// =====================================================================
//  WEBSOCKET CLIENT MANAGEMENT (token auth, slow-client protection)
// =====================================================================
static uint8_t wsAuthedCount() {
  uint8_t n = 0;
  for (uint8_t i = 0; i < WEBSOCKETS_SERVER_CLIENT_MAX; i++) n += g_wsAuthed[i] ? 1 : 0;
  return n;
}

// Sends to every authenticated client. A client whose send fails or blocks
// longer than WS_SLOW_CLIENT_MS is disconnected so it can't stall the monitor.
static void wsSendAll(String& msg) {
  for (uint8_t n = 0; n < WEBSOCKETS_SERVER_CLIENT_MAX; n++) {
    if (!g_wsAuthed[n]) continue;
    const uint32_t t0 = millis();
    const bool ok = webSocket.sendTXT(n, msg);
    const uint32_t dt = millis() - t0;
    if (!ok || dt > WS_SLOW_CLIENT_MS) {
      g_slowClientDrops++;
      g_wsAuthed[n] = false;
      g_wsKick[n] = true;
      Serial.printf("[WS] Client %u dropped (%s, %lu ms)\n", n, ok ? "too slow" : "send failed", (unsigned long)dt);
    }
  }
}

// "L:<off>:<reason bits>"
static void buildLeadMsg(bool off, uint8_t reason) {
  g_lMsg = off ? "L:1:" : "L:0:";
  g_lMsg += (int)reason;
}

static void buildAlarmMsg(uint32_t now);
static void sendInitialState(uint8_t num) {
  buildLeadMsg(s_leadOff, s_leadReason);
  webSocket.sendTXT(num, g_lMsg);
  buildAlarmMsg(millis());
  webSocket.sendTXT(num, g_aMsg);
  if (g_vMsg.length()) webSocket.sendTXT(num, g_vMsg);
}

static void alarmAck(int id, uint32_t now);
static void setStandby(bool on);

static void handleWsText(uint8_t num, const uint8_t* payload, size_t length) {
  char buf[48];
  const size_t n = length < sizeof(buf) - 1 ? length : sizeof(buf) - 1;
  memcpy(buf, payload, n);
  buf[n] = 0;

  if (buf[0] == 'T' && buf[1] == ':') {
    if (strcmp(buf + 2, g_wsToken) == 0) {
      g_wsAuthed[num] = true;
      g_wsPending[num] = false;
      Serial.printf("[WS] Client %u authenticated\n", num);
      sendInitialState(num);
    } else {
      Serial.printf("[WS] Client %u bad token\n", num);
      g_wsKick[num] = true;
    }
    return;
  }
  if (!g_wsAuthed[num]) return;                 // ignore everything else until authed

  if (buf[0] == 'K' && buf[1] == ':') {
    alarmAck(atoi(buf + 2), millis());
  } else if (strcmp(buf, "S:1") == 0) {
    setStandby(true);
  } else if (strcmp(buf, "S:0") == 0) {
    setStandby(false);
  }
}

void webSocketEvent(uint8_t num, WStype_t type, uint8_t* payload, size_t length) {
  if (num >= WEBSOCKETS_SERVER_CLIENT_MAX) return;
  switch (type) {
    case WStype_CONNECTED:
      g_wsAuthed[num] = false;
      g_wsPending[num] = true;
      g_wsKick[num] = false;
      g_wsConnMs[num] = millis();
      Serial.printf("[WS] Client %u connected (awaiting token)\n", num);
      break;
    case WStype_DISCONNECTED:
      g_wsAuthed[num] = false;
      g_wsPending[num] = false;
      g_wsKick[num] = false;
      Serial.printf("[WS] Client %u disconnected\n", num);
      break;
    case WStype_TEXT:
      handleWsText(num, payload, length);
      break;
    default:
      break;
  }
}

static void wsHousekeeping(uint32_t now) {
  for (uint8_t n = 0; n < WEBSOCKETS_SERVER_CLIENT_MAX; n++) {
    if (g_wsPending[n] && now - g_wsConnMs[n] > WS_AUTH_TIMEOUT_MS) {
      Serial.printf("[WS] Client %u: no token in time\n", n);
      g_wsKick[n] = true;
    }
    if (g_wsKick[n]) {
      g_wsKick[n] = false;
      g_wsAuthed[n] = false;
      g_wsPending[n] = false;
      webSocket.disconnect(n);
    }
  }
}

