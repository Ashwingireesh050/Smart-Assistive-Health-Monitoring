static bool i2cPresent(uint8_t addr) {
  Wire.beginTransmission(addr);
  return Wire.endTransmission() == 0;
}

static void i2cScanReport() {
  Serial.println(F("[I2C] Scanning bus (SDA=21, SCL=22)..."));
  bool found = false;
  for (uint8_t a = 1; a < 127; a++) {
    if (i2cPresent(a)) { Serial.printf("[I2C]   device at 0x%02X\n", a); found = true; }
  }
  if (!found) {
    Serial.println(F("[I2C]   NOTHING found on the bus!"));
    Serial.println(F("[I2C]   Check pulse sensor: VIN->3.3V, GND->GND, SDA->GPIO21, SCL->GPIO22"));
    Serial.println(F("[I2C]   Purple GY-MAX30100 board? Its pull-ups go to 1.8 V — fit 4.7k to 3.3 V."));
  }
}

// ==== PULSE OXIMETER MODULE BEGIN ====
// Library-free MAX30100 / MAX30102 driver + PPG signal processing (v3.4).
// Runs entirely inside the sensor task (single I2C owner). Pipeline:
//   FIFO @100 Hz -> DC tracking + 4 Hz low-pass per LED -> 50 Hz ring (8 s)
//   -> automatic LED current (DC kept at 25–80 % of full scale)
//   -> finger detection (IR DC level, with hysteresis)
//   -> heart rate = normalised autocorrelation peak (robust to missed /
//      extra beats, unlike beat-to-beat detectors)
//   -> SpO2 = A - B * R,  R = (ACred/DCred) / (ACir/DCir)  (uncalibrated)
//   -> quality gate: correlation >= 0.5 and perfusion index 0.05–20 %.

enum : uint8_t { PO_CHIP_NONE = 0, PO_CHIP_30100 = 1, PO_CHIP_30102 = 2 };
enum : uint8_t { PO_MISSING = 0, PO_NOFINGER = 1, PO_ADJUSTING = 2, PO_WEAK = 3, PO_GOOD = 4 };

#define PO_ADDR          0x57
#define PO_WIN           400      // 8 s analysis window at 50 Hz
#define PO_AFS_HZ        50.0f    // analysis rate (100 Hz sensor / 2)
#define PO_MIN_FILL      250      // 5 s of clean signal before the first rate
#define PO_LAG_MIN       15       // 200 bpm
#define PO_LAG_MAX       86       // 35 bpm
#define PO_Q_GOOD        0.60f    // autocorrelation peak needed to trust the rate (real pulses: 0.9+)
#define PO_Q_RELEARN     0.80f    // stricter bar for re-learning the motion reference
#define PO_SUBHARM       0.85f    // pick the shortest lag within 85 % of the best peak
#define PO_PI_MIN        0.05f    // perfusion index window (%)
#define PO_PI_MAX        20.0f
#define PO_DC_TARGET     0.50f    // LED control: aim for 50 % of full scale
#define PO_DC_LOW        0.25f
#define PO_DC_HIGH       0.80f
#define PO_DC_SAT        0.95f
#define PO_DC_ALPHA      0.0165f  // DC tracker, tau = 0.6 s at 100 Hz
#define PO_MIN_MA        1.0f
#define PO_MAX_MA        50.0f
#define PO_AGC_MS        500
#define PO_SETTLE_MS     1000     // ignore samples this long after any LED change
#define PO_ANALYSE_MS    1000
#define PO_RETRY_MS      5000
#define PO_I2C_FAIL_MAX  3
#define PO_BLOCK         50       // 1 s blocks for motion detection
#define PO_MOTION_X      3.0f     // block energy > 3x the good-signal level = motion
#define PO_RELEARN_MS    10000    // "motion" this long -> try re-learning from a strongly periodic signal
#define PO_JUMP_FRAC     0.25f    // rate jumps > 25 % must repeat ...
#define PO_JUMP_CONFIRM  3        // ... in 3 consecutive analyses (3 s) before being shown
#ifndef PO_FINGER_ON
#define PO_FINGER_ON     0.15f    // IR DC (fraction of full scale) = finger placed
#endif
#ifndef PO_FINGER_OFF
#define PO_FINGER_OFF    0.08f    // IR DC below this = finger removed
#endif
#ifndef PO_DETECT_MA
#define PO_DETECT_MA     24.0f    // LED current while waiting for a finger
#endif
#ifndef SPO2_CAL_A
#define SPO2_CAL_A       110.0f   // SpO2 = A - B * R (generic, uncalibrated)
#endif
#ifndef SPO2_CAL_B
#define SPO2_CAL_B       25.0f
#endif

// Published to loop() (single writer: sensor task)
volatile uint8_t  s_poChip    = PO_CHIP_NONE;
volatile uint8_t  s_poState   = PO_MISSING;
volatile uint8_t  s_poQuality = 0;     // autocorrelation peak x 100
volatile float    s_poHr      = 0;     // bpm, 0 = not valid
volatile float    s_poSpo2    = 0;     // %,   0 = not valid
volatile float    s_poPi      = 0;     // perfusion index %
volatile float    s_poR       = 0;     // ratio of ratios
volatile float    s_poIrMa    = 0, s_poRedMa = 0;
volatile float    s_poIrDc    = 0, s_poRedDc = 0;   // fraction of full scale

static const float PO_30100_MA[16] = { 0.0f, 4.4f, 7.6f, 11.0f, 14.2f, 17.4f, 20.8f, 24.0f,
                                       27.1f, 30.6f, 33.8f, 37.0f, 40.2f, 43.6f, 46.8f, 50.0f };

struct PoState {
  uint8_t  chip;
  float    fullScale;
  float    irMa, redMa;
  bool     finger;
  uint32_t settleUntil, lastAgcMs, lastAnalyseMs, lastRetryMs;
  uint8_t  i2cFails;
  bool     dcInit;
  float    dcIr, dcRed;
  Biquad   lpIr, lpRed;
  uint8_t  decim;
  float    agcSumIr, agcSumRed, agcMaxIr, agcMaxRed;
  uint16_t agcN;
  float    acIr[PO_WIN], acRed[PO_WIN], dcIrR[PO_WIN], dcRedR[PO_WIN];
  uint16_t idx, fill;
  float    env, v1, v2, periodMs;
  uint32_t lastBeatMs;
  float    refRms;                // AC level of the last good window (motion reference)
  uint32_t motionSinceMs;
  float    lastHr, candHr;        // jump guard
  uint32_t lastHrMs;
  uint8_t  candCount;
  bool     missingLogged;
};
static PoState po;
static float   po_x[PO_WIN];
static float   po_cum[PO_WIN + 1];
static float   po_r[PO_LAG_MAX + 2];

static bool poWriteReg(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(PO_ADDR);
  Wire.write(reg);
  Wire.write(val);
  return Wire.endTransmission() == 0;
}

static bool poReadRegs(uint8_t reg, uint8_t* buf, uint8_t n) {
  Wire.beginTransmission(PO_ADDR);
  Wire.write(reg);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((uint8_t)PO_ADDR, n) != n) {
    while (Wire.available()) Wire.read();
    return false;
  }
  for (uint8_t i = 0; i < n; i++) buf[i] = (uint8_t)Wire.read();
  return true;
}

static uint8_t poCodeFromMa(float ma) {
  if (po.chip == PO_CHIP_30100) {
    uint8_t best = 0;
    for (uint8_t c = 1; c < 16; c++) if (fabsf(PO_30100_MA[c] - ma) < fabsf(PO_30100_MA[best] - ma)) best = c;
    return best;
  }
  long c = lroundf(ma / 0.2f);                     // MAX30102: 0.2 mA per LSB
  if (c < 0) c = 0;
  if (c > 255) c = 255;
  return (uint8_t)c;
}

static float poMaFromCode(uint8_t c) {
  return (po.chip == PO_CHIP_30100) ? PO_30100_MA[c & 0x0F] : c * 0.2f;
}

static uint8_t poMaxCode() { return po.chip == PO_CHIP_30100 ? 15 : 250; }

static bool poApplyLeds() {
  const uint8_t ir = poCodeFromMa(po.irMa), red = poCodeFromMa(po.redMa);
  po.irMa = poMaFromCode(ir);
  po.redMa = poMaFromCode(red);
  s_poIrMa = po.irMa;
  s_poRedMa = po.redMa;
  if (po.chip == PO_CHIP_30100) return poWriteReg(0x09, (uint8_t)((red << 4) | ir));
  return poWriteReg(0x0C, red) && poWriteReg(0x0D, ir);     // LED1 = red, LED2 = IR
}

// Restart analysis (finger placed/removed, LED current changed).
static void poResetAnalysis(uint32_t now) {
  po.fill = 0; po.idx = 0;
  po.dcInit = false;
  po.lpIr.reset(); po.lpRed.reset();
  po.decim = 0;
  po.settleUntil = now + PO_SETTLE_MS;
  po.env = 0; po.v1 = 0; po.v2 = 0;
  po.motionSinceMs = 0;
  po.refRms = 0;                 // amplitude scale changes with LED current / finger
  po.candHr = 0; po.candCount = 0;
}

static void poPublishInvalid(uint8_t state) {
  s_poState = state;
  s_poQuality = 0;
  s_poHr = 0;
  s_poSpo2 = 0;
  if (state <= PO_NOFINGER) { s_poPi = 0; s_poR = 0; }
}

static bool poInit(uint32_t now) {
  po.chip = PO_CHIP_NONE;
  s_poChip = PO_CHIP_NONE;
  s_poxReady = false;
  uint8_t id = 0;
  if (!poReadRegs(0xFF, &id, 1)) {
    if (!po.missingLogged) {
      po.missingLogged = true;
      Serial.println(F("[PPG] No pulse sensor at 0x57 — check VIN/GND/SDA(21)/SCL(22). Retrying every 5 s."));
    }
    return false;
  }
  if (id == 0x11)      { po.chip = PO_CHIP_30100; po.fullScale = 65535.0f; }
  else if (id == 0x15) { po.chip = PO_CHIP_30102; po.fullScale = 262143.0f; }
  else {
    Serial.printf("[PPG] Device at 0x57 has unknown part ID 0x%02X (expect 0x11 MAX30100 / 0x15 MAX30102)\n", id);
    return false;
  }

  const uint8_t modeReg = (po.chip == PO_CHIP_30100) ? 0x06 : 0x09;
  bool ok = poWriteReg(modeReg, 0x40);                       // soft reset
  for (int i = 0; i < 50; i++) {                             // reset clears itself (< 1 ms typ.)
    delay(1);
    uint8_t m = 0x40;
    if (poReadRegs(modeReg, &m, 1) && !(m & 0x40)) break;
  }
  if (po.chip == PO_CHIP_30100) {
    ok &= poWriteReg(0x01, 0x00);                            // interrupts off (polled)
    ok &= poWriteReg(0x07, 0x47);                            // hi-res, 100 Hz, 1600 us -> 16-bit
    ok &= poWriteReg(0x06, 0x03);                            // SpO2 mode (IR + red)
    ok &= poWriteReg(0x02, 0x00) && poWriteReg(0x03, 0x00) && poWriteReg(0x04, 0x00);
  } else {
    ok &= poWriteReg(0x02, 0x00) && poWriteReg(0x03, 0x00);  // interrupts off
    ok &= poWriteReg(0x08, 0x1F);                            // no averaging, FIFO rollover on
    ok &= poWriteReg(0x0A, 0x27);                            // 4096 nA, 100 Hz, 411 us -> 18-bit
    ok &= poWriteReg(0x09, 0x03);                            // SpO2 mode (red + IR)
    ok &= poWriteReg(0x04, 0x00) && poWriteReg(0x05, 0x00) && poWriteReg(0x06, 0x00);
  }
  po.irMa = po.redMa = PO_DETECT_MA;
  ok &= poApplyLeds();
  if (!ok) {
    Serial.println(F("[PPG] Sensor configuration failed — retrying."));
    po.chip = PO_CHIP_NONE;
    return false;
  }
  po.lpIr.lowpass(4.0f, 100.0f, 0.7071f);                   // PPG band: < 4 Hz (240 bpm)
  po.lpRed.lowpass(4.0f, 100.0f, 0.7071f);
  po.finger = false;
  po.i2cFails = 0;
  po.agcSumIr = po.agcSumRed = po.agcMaxIr = po.agcMaxRed = 0;
  po.agcN = 0;
  po.lastAgcMs = po.lastAnalyseMs = now;
  po.periodMs = 0;
  po.lastBeatMs = 0;
  po.missingLogged = false;
  po.refRms = 0;
  po.lastHr = 0;
  poResetAnalysis(now);
  s_poChip = po.chip;
  s_poxReady = true;
  poPublishInvalid(PO_NOFINGER);
  Serial.printf("[PPG] %s detected (part ID 0x%02X) — 100 Hz, %s, automatic LED current\n",
                po.chip == PO_CHIP_30100 ? "MAX30100" : "MAX30102", id,
                po.chip == PO_CHIP_30100 ? "16-bit" : "18-bit");
  return true;
}

static void poProcessSample(uint32_t irRaw, uint32_t redRaw, uint32_t now) {
  const float ir = irRaw / po.fullScale, red = redRaw / po.fullScale;

  po.agcSumIr += ir; po.agcSumRed += red;
  if (ir > po.agcMaxIr) po.agcMaxIr = ir;
  if (red > po.agcMaxRed) po.agcMaxRed = red;
  po.agcN++;

  if (!po.dcInit) {                                          // seed: no start-up transient
    po.dcIr = ir; po.dcRed = red; po.dcInit = true;
  } else {
    po.dcIr  += (ir  - po.dcIr)  * PO_DC_ALPHA;
    po.dcRed += (red - po.dcRed) * PO_DC_ALPHA;
  }
  const float acI = po.lpIr.process(ir - po.dcIr);
  const float acR = po.lpRed.process(red - po.dcRed);

  if (!po.finger || (int32_t)(now - po.settleUntil) < 0) return;
  if (++po.decim < 2) return;                                // 100 Hz -> 50 Hz
  po.decim = 0;

  po.acIr[po.idx] = acI;     po.acRed[po.idx] = acR;
  po.dcIrR[po.idx] = po.dcIr; po.dcRedR[po.idx] = po.dcRed;
  po.idx = (uint16_t)((po.idx + 1) % PO_WIN);
  if (po.fill < PO_WIN) po.fill++;

  // Beat events for the heart icon. Blood absorbs light, so the systolic
  // pulse is a DIP in the raw signal: detect peaks of the inverted signal.
  const float v = -acI;
  po.env = fmaxf(fabsf(v), po.env * 0.995f);
  if (po.v1 > po.v2 && po.v1 >= v && po.v1 > 0.35f * po.env) {
    uint32_t minGap = 250;
    if (po.periodMs > 0) minGap = (uint32_t)fmaxf(250.0f, 0.55f * po.periodMs);
    if (now - po.lastBeatMs >= minGap) {
      po.lastBeatMs = now;
      s_lastBeatMs = now;
      s_beatCount = s_beatCount + 1;
    }
  }
  po.v2 = po.v1; po.v1 = v;
}

// One LED: returns true if the current was changed.
static bool poAdjustLed(float& ma, float mean, float mx) {
  float target;
  if (mx >= PO_DC_SAT) {
    target = ma * 0.5f;                                      // saturated: halve
  } else if (mean > PO_DC_HIGH || mean < PO_DC_LOW) {
    float ratio = PO_DC_TARGET / fmaxf(mean, 0.01f);
    if (ratio < 0.5f) ratio = 0.5f;
    if (ratio > 2.0f) ratio = 2.0f;
    target = ma * ratio;
  } else {
    return false;
  }
  if (target < PO_MIN_MA) target = PO_MIN_MA;
  if (target > PO_MAX_MA) target = PO_MAX_MA;
  const uint8_t oldC = poCodeFromMa(ma);
  uint8_t newC = poCodeFromMa(target);
  if (newC == oldC) {                                        // force at least one step
    if (target > ma && oldC < poMaxCode()) newC = oldC + 1;
    else if (target < ma && oldC > 1) newC = oldC - 1;
    else return false;
  }
  ma = poMaFromCode(newC);
  return true;
}

static void poAgc(uint32_t now) {
  if (!po.agcN) return;
  const float meanIr = po.agcSumIr / po.agcN, meanRed = po.agcSumRed / po.agcN;
  const float maxIr = po.agcMaxIr, maxRed = po.agcMaxRed;
  po.agcSumIr = po.agcSumRed = po.agcMaxIr = po.agcMaxRed = 0;
  po.agcN = 0;
  s_poIrDc = meanIr;
  s_poRedDc = meanRed;

  const bool was = po.finger;
  if (!po.finger && (meanIr >= PO_FINGER_ON || maxIr >= PO_DC_SAT)) po.finger = true;
  else if (po.finger && meanIr < PO_FINGER_OFF) po.finger = false;
  if (po.finger != was) {
    if (!po.finger) { po.irMa = po.redMa = PO_DETECT_MA; poApplyLeds(); }
    po.periodMs = 0;
    po.lastHr = 0;
    poResetAnalysis(now);
    return;
  }
  if (!po.finger) return;
  const bool a = poAdjustLed(po.irMa, meanIr, maxIr);
  const bool b = poAdjustLed(po.redMa, meanRed, maxRed);
  if (a || b) {
    poApplyLeds();
    poResetAnalysis(now);
  }
}

static void poAnalyse(uint32_t now) {
  if (!po.finger) { poPublishInvalid(PO_NOFINGER); return; }
  if ((int32_t)(now - po.settleUntil) < 0 || po.fill < PO_MIN_FILL) { poPublishInvalid(PO_ADJUSTING); return; }

  // ---- Motion rejection: 1 s blocks, newest first; analyse only the clean
  // signal after the most recent motion block.
  const uint16_t full = po.fill;
  const uint16_t nBlocks = full / PO_BLOCK;
  float blk[PO_WIN / PO_BLOCK];
  for (uint16_t b = 0; b < nBlocks; b++) {                     // b = 0 is the newest second
    float e = 0, mu = 0;
    for (uint16_t i = 0; i < PO_BLOCK; i++) mu += po.acIr[(po.idx + PO_WIN - 1 - (b * PO_BLOCK + i)) % PO_WIN];
    mu /= PO_BLOCK;
    for (uint16_t i = 0; i < PO_BLOCK; i++) {
      const float d = po.acIr[(po.idx + PO_WIN - 1 - (b * PO_BLOCK + i)) % PO_WIN] - mu;
      e += d * d;
    }
    blk[b] = sqrtf(e / PO_BLOCK);
  }
  float ref = po.refRms;
  if (ref <= 0) {                                              // no reference yet: median block
    float t[PO_WIN / PO_BLOCK];
    for (uint16_t b = 0; b < nBlocks; b++) t[b] = blk[b];
    std::sort(t, t + nBlocks);
    ref = nBlocks ? t[nBlocks / 2] : 0;
  }
  uint16_t cleanBlocks = nBlocks;
  for (uint16_t b = 0; b < nBlocks; b++) if (ref > 0 && blk[b] > PO_MOTION_X * ref) { cleanBlocks = b; break; }
  const bool motionNow = cleanBlocks < nBlocks;
  bool relearn = false;
  if (motionNow) {
    if (!po.motionSinceMs) po.motionSinceMs = now;
    // Flagged for a long time: either real motion, or the pulse amplitude
    // genuinely changed (finger pressure). Test the newest 5 s with a strict
    // periodicity bar; only a clearly rhythmic signal may replace the reference.
    if (now - po.motionSinceMs > PO_RELEARN_MS) { relearn = true; cleanBlocks = PO_MIN_FILL / PO_BLOCK; }
  } else {
    po.motionSinceMs = 0;
  }
  const uint16_t n = (uint16_t)((motionNow || relearn) ? cleanBlocks * PO_BLOCK : full);
  if (n < PO_MIN_FILL) { poPublishInvalid(PO_WEAK); return; }  // hold still: not enough clean signal
  const uint16_t start = (uint16_t)((po.idx + PO_WIN - n) % PO_WIN);
  float meanI = 0, meanR = 0, dcI = 0, dcR = 0;
  for (uint16_t i = 0; i < n; i++) {
    const uint16_t j = (uint16_t)((start + i) % PO_WIN);
    po_x[i] = po.acIr[j];
    meanI += po.acIr[j]; meanR += po.acRed[j];
    dcI += po.dcIrR[j];  dcR += po.dcRedR[j];
  }
  meanI /= n; meanR /= n; dcI /= n; dcR /= n;
  float eR = 0;
  po_cum[0] = 0;
  for (uint16_t i = 0; i < n; i++) {
    po_x[i] -= meanI;
    po_cum[i + 1] = po_cum[i] + po_x[i] * po_x[i];
    const float d = po.acRed[(start + i) % PO_WIN] - meanR;
    eR += d * d;
  }
  const float rmsI = sqrtf(po_cum[n] / n), rmsR = sqrtf(eR / n);
  const float pi = (dcI > 0) ? 2.828f * rmsI / dcI * 100.0f : 0;
  s_poPi = pi;

  // Normalised autocorrelation over 35–200 bpm
  int kMax = PO_LAG_MAX;
  if (kMax > n / 2) kMax = n / 2;
  for (int k = PO_LAG_MIN - 1; k <= kMax + 1; k++) {
    float num = 0;
    const int m = n - k;
    for (int i = 0; i < m; i++) num += po_x[i] * po_x[i + k];
    const float e1 = po_cum[m], e2 = po_cum[n] - po_cum[k];
    po_r[k] = (e1 > 0 && e2 > 0) ? num / sqrtf(e1 * e2) : 0;
  }
  float rMax = 0;
  for (int k = PO_LAG_MIN; k <= kMax; k++)
    if (po_r[k] > po_r[k - 1] && po_r[k] >= po_r[k + 1] && po_r[k] > rMax) rMax = po_r[k];
  int kBest = -1;
  for (int k = PO_LAG_MIN; k <= kMax && kBest < 0; k++)      // shortest strong lag = true period
    if (po_r[k] > po_r[k - 1] && po_r[k] >= po_r[k + 1] && po_r[k] >= PO_SUBHARM * rMax && po_r[k] > 0) kBest = k;

  float q = 0, hr = 0;
  if (kBest > 0) {
    q = po_r[kBest];
    const float a = po_r[kBest - 1], b = po_r[kBest], c = po_r[kBest + 1];
    const float den = a - 2.0f * b + c;
    float lag = (float)kBest;
    if (den < 0) lag += 0.5f * (a - c) / den;                // parabolic peak interpolation
    hr = 60.0f * PO_AFS_HZ / lag;
  }
  const float R = (dcR > 0 && dcI > 0 && rmsI > 0) ? (rmsR / dcR) / (rmsI / dcI) : 0;
  s_poR = R;
  s_poQuality = (uint8_t)(q > 0 ? (q > 1 ? 100 : q * 100) : 0);

  bool good = q >= (relearn ? PO_Q_RELEARN : PO_Q_GOOD) && pi >= PO_PI_MIN && pi <= PO_PI_MAX && hr >= 35.0f && hr <= 200.0f;

  // Jump guard: a rate far from the last good one must repeat for 3 s.
  if (good && po.lastHr > 0 && now - po.lastHrMs < 15000 && fabsf(hr - po.lastHr) > PO_JUMP_FRAC * po.lastHr) {
    if (po.candHr > 0 && fabsf(hr - po.candHr) <= 0.10f * po.candHr) po.candCount++;
    else { po.candHr = hr; po.candCount = 1; }
    if (po.candCount < PO_JUMP_CONFIRM) good = false;
  }
  if (good) {
    po.lastHr = hr; po.lastHrMs = now;
    po.candHr = 0; po.candCount = 0;
    if (relearn) { po.refRms = rmsI; po.motionSinceMs = 0; }
    float spo2 = SPO2_CAL_A - SPO2_CAL_B * R;
    if (spo2 > 100.0f) spo2 = 100.0f;
    if (spo2 < 0.0f) spo2 = 0.0f;
    s_poHr = hr;
    s_poSpo2 = (R > 0) ? spo2 : 0;
    s_poState = PO_GOOD;
    po.periodMs = 60000.0f / hr;
    po.refRms = (po.refRms <= 0) ? rmsI : 0.8f * po.refRms + 0.2f * rmsI;   // learn good-signal level
  } else {
    s_poHr = 0;
    s_poSpo2 = 0;
    s_poState = PO_WEAK;
  }
}

static void poLost(uint32_t now, const char* why) {
  Serial.printf("[PPG] Sensor lost (%s) — will re-initialise.\n", why);
  po.chip = PO_CHIP_NONE;
  s_poChip = PO_CHIP_NONE;
  s_poxReady = false;
  po.lastRetryMs = now;
  poPublishInvalid(PO_MISSING);
}

// Called from the sensor task every 12 ms.
static void poService(uint32_t now) {
  if (po.chip == PO_CHIP_NONE) {
    poPublishInvalid(PO_MISSING);
    if (now - po.lastRetryMs >= PO_RETRY_MS) { po.lastRetryMs = now; poInit(now); }
    return;
  }
  const bool     is100  = po.chip == PO_CHIP_30100;
  const uint8_t  depth  = is100 ? 16 : 32;
  const uint8_t  bytesS = is100 ? 4 : 6;
  const uint8_t  ptrReg = is100 ? 0x02 : 0x04;               // WR_PTR, OVF, RD_PTR (consecutive)
  const uint8_t  datReg = is100 ? 0x05 : 0x07;
  uint8_t p[3];
  if (!poReadRegs(ptrReg, p, 3)) {
    if (++po.i2cFails >= PO_I2C_FAIL_MAX) poLost(now, "I2C not responding");
    return;
  }
  po.i2cFails = 0;
  uint8_t n = (uint8_t)((p[0] - p[2]) & (depth - 1));
  if (n == 0 && p[1] != 0) n = depth;                        // FIFO full / overflowed
  const uint8_t maxChunk = (uint8_t)(120 / bytesS);          // stay inside the 128-byte Wire buffer
  uint8_t buf[120];
  while (n > 0) {
    const uint8_t c = n < maxChunk ? n : maxChunk;
    if (!poReadRegs(datReg, buf, (uint8_t)(c * bytesS))) {
      if (++po.i2cFails >= PO_I2C_FAIL_MAX) poLost(now, "FIFO read failed");
      return;
    }
    for (uint8_t s = 0; s < c; s++) {
      const uint8_t* b = buf + s * bytesS;
      uint32_t ir, red;
      if (is100) {                                           // MAX30100: IR then red, 16-bit
        ir  = ((uint32_t)b[0] << 8) | b[1];
        red = ((uint32_t)b[2] << 8) | b[3];
      } else {                                               // MAX30102: red then IR, 18-bit
        red = (((uint32_t)b[0] << 16) | ((uint32_t)b[1] << 8) | b[2]) & 0x3FFFF;
        ir  = (((uint32_t)b[3] << 16) | ((uint32_t)b[4] << 8) | b[5]) & 0x3FFFF;
      }
      poProcessSample(ir, red, now);
    }
    n -= c;
  }
  if (now - po.lastAgcMs >= PO_AGC_MS) { po.lastAgcMs = now; poAgc(now); }
  if (now - po.lastAnalyseMs >= PO_ANALYSE_MS) { po.lastAnalyseMs = now; poAnalyse(now); }
}
